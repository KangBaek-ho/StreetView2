<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>로드뷰</title>
<style>
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;height:100%;background:#000;overflow:hidden;font-family:"Malgun Gothic","Apple SD Gothic Neo",sans-serif}
  #stage{position:fixed;inset:0;overflow:hidden;cursor:grab;touch-action:none;user-select:none;-webkit-user-select:none}
  #stage.dragging{cursor:grabbing}
  #pano{position:absolute;left:0;top:0;will-change:transform;transition:opacity .18s ease}
  #pano.fade{opacity:0}
  .tile{position:absolute;top:0;width:100%;height:100%}
  .tile img{width:100%;height:100%;display:block;pointer-events:none;-webkit-user-drag:none}
  .hs{position:absolute;transform:translate(-50%,-50%);border:0;padding:0;background:transparent;border-radius:50%;cursor:pointer;
      outline:none;transition:background .15s, box-shadow .15s, transform .15s}
  .hs:hover,.hs:focus-visible{background:rgba(255,255,255,.28);box-shadow:0 0 0 3px rgba(255,255,255,.9),0 0 22px 6px rgba(120,200,255,.8);transform:translate(-50%,-50%) scale(1.08)}
  .hs.dead{cursor:not-allowed}
  .hs.dead:hover{background:rgba(255,80,80,.18);box-shadow:0 0 0 3px rgba(255,120,120,.8)}
  #home{position:fixed;left:14px;top:12px;width:44px;height:44px;border-radius:50%;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);
        display:flex;align-items:center;justify-content:center;z-index:7;transition:background .15s,transform .15s}
  #home:hover,#home:focus-visible{background:rgba(0,0,0,.72);transform:scale(1.08);outline:none}
  #home svg{width:24px;height:24px;fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
  #gyro{position:fixed;right:14px;top:12px;width:44px;height:44px;border-radius:50%;border:0;padding:0;background:rgba(0,0,0,.5);backdrop-filter:blur(4px);
        display:none;align-items:center;justify-content:center;z-index:7;cursor:pointer;transition:background .15s,transform .15s}
  #gyro.avail{display:flex}
  #gyro:active{transform:scale(.94)}
  #gyro.on{background:rgba(30,136,229,.92)}
  #gyro svg{width:26px;height:26px;fill:none;stroke:#fff;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  #hint{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);color:#fff;background:rgba(0,0,0,.5);padding:8px 16px;border-radius:20px;
        font-size:13px;pointer-events:none;transition:opacity .8s;z-index:5;white-space:nowrap}
  #toast{position:fixed;left:50%;top:60px;transform:translateX(-50%);color:#fff;background:rgba(0,0,0,.65);padding:8px 16px;border-radius:20px;
         font-size:14px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:6}
</style>
</head>
<body>
<div id="stage"><div id="pano"></div></div>
<a id="home" href="https://kangbaek-ho.github.io/map/" aria-label="지도로 이동" title="지도"><svg viewBox="0 0 24 24"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9.5h4.5v-6h4v6h4.5V10"/></svg></a>
<button id="gyro" type="button" aria-label="폰을 움직여 둘러보기" title="폰을 움직여 둘러보기"><svg viewBox="0 0 24 24"><rect x="8.2" y="5" width="7.6" height="14" rx="1.8"/><path d="M5.2 9.2c-1.3 1.7-1.3 4.9 0 6.6M3.6 14.6l1.6 1.7 1.7-1.5"/><path d="M18.8 9.2c1.3 1.7 1.3 4.9 0 6.6M20.4 14.6l-1.6 1.7-1.7-1.5"/></svg></button>
<div id="hint">드래그로 둘러보고, 스크롤로 확대·축소, 화살표를 눌러 이동하세요</div>
<div id="toast"></div>
<script>
const PHOTOS = [{"n": 20, "src": "data:image/jpeg;base64,", "ar": 3.50597609561753, "hs": [{"x": 0.36045454545454547, "y": 0.799203187250996, "w": 0.038, "h": 0.17928286852589642, "to": null}]}, {"n": 21, "src": "data:image/jpeg;base64,", "ar": 3.3259423503325944, "hs": [{"x": 0.7204545454545455, "y": 0.7560606060606061, "w": 0.03559090909090909, "h": 0.1803030303030303, "to": 22}]}, {"n": 22, "src": "data:image/jpeg;base64,", "ar": 3.289473684210526, "hs": [{"x": 0.4777272727272727, "y": 0.5778443113772455, "w": 0.03559090909090909, "h": 0.17305389221556886, "to": 21}, {"x": 0.8409090909090909, "y": 0.47754491017964074, "w": 0.028999999999999998, "h": 0.18832335329341315, "to": 23}]}, {"n": 23, "src": "data:image/jpeg;base64,", "ar": 3.278688524590164, "hs": [{"x": 0.34545454545454546, "y": 0.43283582089552236, "w": 0.028999999999999998, "h": 0.1928358208955224, "to": 22}, {"x": 0.9745454545454545, "y": 0.6029850746268657, "w": 0.04218181818181818, "h": 0.15223880597014924, "to": 24}]}, {"n": 24, "src": "data:image/jpeg;base64,", "ar": 3.2432432432432434, "hs": [{"x": 0.2840909090909091, "y": 0.43215339233038347, "w": 0.03559090909090909, "h": 0.17551622418879056, "to": 23}, {"x": 0.925, "y": 0.48525073746312686, "w": 0.030318181818181817, "h": 0.1855457227138643, "to": 25}]}, {"n": 25, "src": "data:image/jpeg;base64,", "ar": 3.3003300330033003, "hs": [{"x": 0.29772727272727273, "y": 0.43093093093093093, "w": 0.027681818181818182, "h": 0.1990990990990991, "to": 24}, {"x": 0.7954545454545454, "y": 0.47147147147147145, "w": 0.05272727272727272, "h": 0.15, "to": 26}]}, {"n": 26, "src": "data:image/jpeg;base64,", "ar": 3.1645569620253164, "hs": [{"x": 0.27636363636363637, "y": 0.5043227665706052, "w": 0.028999999999999998, "h": 0.18616714697406342, "to": 25}, {"x": 0.8763636363636363, "y": 0.5749279538904899, "w": 0.027, "h": 0.20086455331412104, "to": 27}]}, {"n": 27, "src": "data:image/jpeg;base64,", "ar": 3.2467532467532467, "hs": [{"x": 0.17272727272727273, "y": 0.5029585798816568, "w": 0.027, "h": 0.2011834319526627, "to": 26}, {"x": 0.8004545454545454, "y": 0.5769230769230769, "w": 0.03559090909090909, "h": 0.17100591715976332, "to": 28}]}, {"n": 28, "src": "data:image/jpeg;base64,", "ar": 3.416856492027335, "hs": [{"x": 0.32227272727272727, "y": 0.5342679127725857, "w": 0.027681818181818182, "h": 0.20654205607476636, "to": 27}, {"x": 0.8590909090909091, "y": 0.5342679127725857, "w": 0.027, "h": 0.20654205607476636, "to": 29}]}, {"n": 29, "src": "data:image/jpeg;base64,", "ar": 3.4246575342465753, "hs": [{"x": 0.3931818181818182, "y": 0.5062305295950156, "w": 0.027681818181818182, "h": 0.20654205607476636, "to": 28}, {"x": 0.8504545454545455, "y": 0.5825545171339563, "w": 0.030318181818181817, "h": 0.2012461059190031, "to": 30}]}, {"n": 30, "src": "data:image/jpeg;base64,", "ar": 3.5502958579881656, "hs": [{"x": 0.35863636363636364, "y": 0.46440129449838186, "w": 0.027, "h": 0.2255663430420712, "to": 29}, {"x": 0.8472727272727273, "y": 0.5436893203883495, "w": 0.034272727272727274, "h": 0.19805825242718447, "to": 31}]}, {"n": 31, "src": "data:image/jpeg;base64,", "ar": 3.3003300330033003, "hs": [{"x": 0.32045454545454544, "y": 0.4159159159159159, "w": 0.027, "h": 0.2093093093093093, "to": 30}, {"x": 0.7981818181818182, "y": 0.39039039039039036, "w": 0.04218181818181818, "h": 0.15315315315315314, "to": 33}, {"x": 0.8295454545454546, "y": 0.35135135135135137, "w": 0.027, "h": 0.2042042042042042, "to": 32}]}, {"n": 32, "src": "data:image/jpeg;base64,", "ar": 3.4403669724770642, "hs": [{"x": 0.36863636363636365, "y": 0.43260188087774293, "w": 0.027, "h": 0.21316614420062693, "to": 31}]}, {"n": 33, "src": "data:image/jpeg;base64,", "ar": 3.605769230769231, "hs": [{"x": 0.3613636363636364, "y": 0.40491803278688526, "w": 0.04613636363636363, "h": 0.15049180327868852, "to": 31}, {"x": 0.9054545454545454, "y": 0.4524590163934426, "w": 0.03690909090909091, "h": 0.18950819672131147, "to": 34}]}, {"n": 34, "src": "data:image/jpeg;base64,", "ar": 3.256637168141593, "hs": []}];
let zoom = 1.25;                 // 현재 배율 (1.0 = 화면에 딱 맞게, 처음엔 살짝 확대)
const ZMIN = 1.0, ZMAX = 3.5;    // 스크롤로 줄이고 늘릴 수 있는 범위
const byN = {}; PHOTOS.forEach(p=>byN[p.n]=p);

const stage=document.getElementById('stage'), pano=document.getElementById('pano');
const hint=document.getElementById('hint'), toast=document.getElementById('toast');
let cur=null, PW=0, PH=0, tx=0, ty=0, busy=false;

function clamp(){
  const vw=innerWidth, vh=innerHeight;
  if(!wrap) tx = PW<=vw ? (vw-PW)/2 : Math.min(0, Math.max(vw-PW, tx));
  ty = PH<=vh ? (vh-PH)/2 : Math.min(0, Math.max(vh-PH, ty));
}
let wrap=false;                   // 파노라마(가로 사진)는 왼쪽 끝과 오른쪽 끝이 이어져요
function apply(){
  clamp();
  if(wrap) tx=(((tx%PW)+PW)%PW)-PW;   // tx를 (-PW, 0] 범위로 되감아 무한히 돌게 함
  pano.style.transform=`translate(${tx}px,${ty}px)`;
}

function size(){
  const vw=innerWidth, vh=innerHeight;
  const cover=Math.max(vw/(cur.ar*1000), vh/1000);   // 화면을 꽉 채우는 배율
  PH=1000*cover*zoom; PW=PH*cur.ar;
  pano.style.width=PW+'px'; pano.style.height=PH+'px';
}
function layout(keepCenter){
  if(!cur) return;
  const vw=innerWidth, vh=innerHeight;
  let fx=0.5, fy=0.5;
  if(keepCenter){ fx=(vw/2-tx)/PW; fy=(vh/2-ty)/PH; }
  size();
  tx=vw/2-fx*PW; ty=vh/2-fy*PH;
  apply();
}
function zoomAt(z,cx,cy){            // (cx,cy) 화면 좌표를 기준으로 확대/축소
  z=Math.min(ZMAX,Math.max(ZMIN,z));
  if(z===zoom) return;
  const fx=(cx-tx)/PW, fy=(cy-ty)/PH;
  zoom=z; size();
  tx=cx-fx*PW; ty=cy-fy*PH;
  apply();
}

function build(p){
  pano.innerHTML='';
  const tiles = wrap ? 2 : 1;               // 순환할 때는 같은 사진을 오른쪽에 한 장 더 이어 붙임
  for(let t=0;t<tiles;t++){
    const tile=document.createElement('div'); tile.className='tile'; tile.style.left=(t*100)+'%';
    const im=document.createElement('img'); im.alt=''; im.src=p.src; tile.appendChild(im);
    p.hs.forEach(h=>{
      const b=document.createElement('button');
      b.className='hs'+(h.to==null?' dead':'');
      b.style.left=(h.x*100)+'%'; b.style.top=(h.y*100)+'%';
      b.style.width=(h.w*100)+'%'; b.style.height=(h.h*100)+'%';
      b.setAttribute('aria-label', h.to==null?'이동 불가':`그림 ${h.to}번으로 이동`);
      b.addEventListener('click',e=>{
        if(moved>6) return;                      // 드래그였으면 무시
        if(h.to==null){ say('이쪽으로는 갈 수 없어요'); return; }   // 그림20의 앞쪽 화살표 등
        go(h.to);
      });
      tile.appendChild(b);
    });
    pano.appendChild(tile);
  }
}

function show(n, keep){
  const p=byN[n]; if(!p) return;
  stopInertia(); cur=p; wrap=p.ar>1; build(p); layout(false);
  // 세로 사진은 화살표가 보이는 높이에서 시작
  if(p.ar<1){ const avg=p.hs.reduce((s,h)=>s+h.y,0)/p.hs.length; ty=innerHeight/2-avg*PH; apply(); }
  // 이전 사진에서 보던 위치(왼쪽 끝/위쪽 끝이 사진의 몇 %인지)를 그대로 이어받음 (같은 종류의 사진끼리)
  if(keep && keep.wrap===wrap){ tx=-keep.l*PW; ty=-keep.t*PH; apply(); }
  setHash(n);
  [].concat(...p.hs.map(h=>h.to?[h.to]:[])).forEach(t=>{ if(!byN[t]) return; const i=new Image(); i.src=byN[t].src; });  // 다음 사진 미리 불러오기
}
function setHash(n){
  try{ history.replaceState(null,'','#'+n); }catch(e){ location.replace('#'+n); }
}
function go(n){
  if(busy) return;
  if(!byN[n]){ say('아직 없는 사진이에요'); return; }
  busy=true;
  pano.classList.add('fade');
  setTimeout(()=>{ show(n, {wrap, l:-tx/PW, t:-ty/PH}); requestAnimationFrame(()=>{ pano.classList.remove('fade'); busy=false; }); },190);
}
let tt; function say(m){ toast.textContent=m; toast.style.opacity=1; clearTimeout(tt); tt=setTimeout(()=>toast.style.opacity=0,1400); }

/* 드래그로 둘러보기 (마우스 + 터치) + 관성 / 스크롤·핀치로 확대·축소 */
let down=false, sx=0, sy=0, stx=0, sty=0, moved=0;
let vx=0, vy=0, lastX=0, lastY=0, lastT=0, raf=0;
const FRICTION=0.94;             // 1에 가까울수록 더 오래 미끄러져요
const ptrs=new Map(); let pinch=null;
function stopInertia(){ cancelAnimationFrame(raf); raf=0; vx=vy=0; }
function inertia(){
  let prev=performance.now();
  const step=now=>{
    const dt=Math.min(32,now-prev); prev=now;
    const ox=tx, oy=ty;
    tx+=vx*dt; ty+=vy*dt; apply();
    if(tx===ox) vx=0;            // 가장자리에 닿으면 그 방향은 멈춤
    if(ty===oy) vy=0;
    const f=Math.pow(FRICTION,dt/16.7); vx*=f; vy*=f;
    if(Math.hypot(vx,vy)>0.02) raf=requestAnimationFrame(step); else raf=0;
  };
  raf=requestAnimationFrame(step);
}
function pinchInfo(){
  const [a,b]=[...ptrs.values()];
  return {d:Math.hypot(a.x-b.x,a.y-b.y)||1, cx:(a.x+b.x)/2, cy:(a.y+b.y)/2};
}
stage.addEventListener('pointerdown',e=>{
  stopInertia(); hint.style.opacity=0;
  ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(ptrs.size===2){                       // 두 손가락 → 핀치 확대/축소
    down=false; moved=999; stage.classList.remove('dragging');
    const p=pinchInfo(); pinch={d:p.d, z:zoom}; return;
  }
  if(ptrs.size>2) return;
  down=true; moved=0; sx=e.clientX; sy=e.clientY; stx=tx; sty=ty;
  lastX=e.clientX; lastY=e.clientY; lastT=performance.now();
  stage.classList.add('dragging');
});
addEventListener('pointermove',e=>{
  if(ptrs.has(e.pointerId)) ptrs.set(e.pointerId,{x:e.clientX,y:e.clientY});
  if(pinch && ptrs.size>=2){ const p=pinchInfo(); zoomAt(pinch.z*p.d/pinch.d,p.cx,p.cy); return; }
  if(!down) return;
  const dx=e.clientX-sx, dy=e.clientY-sy;
  moved=Math.max(moved,Math.hypot(dx,dy));
  tx=stx+dx; ty=sty+dy; apply();       // 마우스를 위→아래로 당기면 사진이 아래로 내려와 위쪽이 보여요
  const now=performance.now(), dt=now-lastT;
  if(dt>0){                      // 최근 움직임 속도(px/ms)를 부드럽게 갱신
    vx=0.6*((e.clientX-lastX)/dt)+0.4*vx;
    vy=0.6*((e.clientY-lastY)/dt)+0.4*vy;
  }
  lastX=e.clientX; lastY=e.clientY; lastT=now;
});
function release(e){
  ptrs.delete(e.pointerId);
  if(pinch){ if(ptrs.size<2) pinch=null; down=false; stage.classList.remove('dragging'); setTimeout(()=>moved=0,0); return; }
  if(!down) return; down=false; stage.classList.remove('dragging');
  if(performance.now()-lastT>80){ vx=vy=0; }      // 멈춘 뒤 놓으면 관성 없음
  if(moved>6 && Math.hypot(vx,vy)>0.05) inertia();
  setTimeout(()=>moved=0,0);
}
addEventListener('pointerup',release);
addEventListener('pointercancel',release);

/* 마우스 스크롤 = 확대/축소 (사진은 움직이지 않아요). 위로 굴리면 확대, 아래로 굴리면 축소 */
stage.addEventListener('wheel',e=>{
  e.preventDefault(); stopInertia();
  zoomAt(zoom*Math.exp(-e.deltaY*0.0015), e.clientX, e.clientY);
  hint.style.opacity=0;
},{passive:false});
addEventListener('keydown',e=>{
  const k=e.key, s=60;
  if(k==='ArrowLeft') tx+=s; else if(k==='ArrowRight') tx-=s; else if(k==='ArrowUp') ty+=s; else if(k==='ArrowDown') ty-=s; else return;
  apply();
});
addEventListener('resize',()=>layout(true));

/* 폰을 움직여 둘러보기 (모션 센서) - 터치 기기에서만 버튼이 보여요 */
const gyroBtn=document.getElementById('gyro');
let gyroOn=false, gF=null, gPrev=null, gGot=false;
if(('DeviceOrientationEvent' in window) && (matchMedia('(pointer:coarse)').matches || navigator.maxTouchPoints>0)) gyroBtn.classList.add('avail');
const wrap180=d=>((d+180)%360+360)%360-180;
function onOrient(e){
  if(e.alpha==null||e.beta==null||e.gamma==null) return;
  gGot=true;
  const r=Math.PI/180, A=e.alpha*r, B=e.beta*r, G=e.gamma*r;
  const sA=Math.sin(A), cA=Math.cos(A), sB=Math.sin(B), cB=Math.cos(B), sG=Math.sin(G), cG=Math.cos(G);
  // 폰 뒷면이 바라보는 방향 (화면 밖으로 나가는 축의 반대)
  const lx=-(sG*cA+sB*cG*sA), ly=-(sG*sA-sB*cG*cA), lz=-(cB*cG);
  const yaw=Math.atan2(lx,ly)/r, pitch=Math.asin(Math.max(-1,Math.min(1,lz)))/r;
  if(Math.abs(pitch)>80){ gF=null; return; }          // 폰을 바닥/천장 쪽으로 향하면 방향이 불안정해서 잠시 무시
  if(!gF){ gF={yaw,pitch}; gPrev={yaw,pitch}; return; }
  gF.yaw+=wrap180(yaw-gF.yaw)*0.4; gF.pitch+=(pitch-gF.pitch)*0.4;   // 떨림 줄이기
  const dy=wrap180(gF.yaw-gPrev.yaw), dp=gF.pitch-gPrev.pitch;
  gPrev={yaw:gF.yaw,pitch:gF.pitch};
  if(Math.abs(dy)<0.03&&Math.abs(dp)<0.03) return;
  stopInertia();
  tx-=dy*PW/(wrap?220:70);       // 폰을 오른쪽으로 돌리면 사진의 오른쪽이 보임
  ty+=dp*PH/(wrap?65:90);        // 폰을 위로 들면 사진의 위쪽이 보임
  apply();
}
async function setGyro(on){
  if(on){
    if(typeof DeviceOrientationEvent!=='undefined' && typeof DeviceOrientationEvent.requestPermission==='function'){   // 아이폰은 권한 허용이 필요
      try{ const res=await DeviceOrientationEvent.requestPermission(); if(res!=='granted'){ say('모션 센서 권한을 허용해야 사용할 수 있어요'); return; } }
      catch(err){ say('모션 센서를 사용할 수 없어요'); return; }
    }
    gF=null; gPrev=null; gGot=false;
    addEventListener('deviceorientation',onOrient);
    gyroOn=true; gyroBtn.classList.add('on'); stopInertia(); hint.style.opacity=0; say('폰을 움직여 둘러보세요');
    setTimeout(()=>{ if(gyroOn&&!gGot){ setGyro(false); say('이 기기에서는 모션 센서를 쓸 수 없어요'); } },2000);
  }else{
    removeEventListener('deviceorientation',onOrient);
    gyroOn=false; gyroBtn.classList.remove('on');
  }
}
